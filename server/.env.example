# Copy to server/.env and replace every placeholder before starting the API.
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/erp?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
CLIENT_ORIGIN="http://localhost:5173"
SERVER_PORT=3000
NODE_ENV=development

# Bootstrap account used by `npm run db:seed`.
# Seeding again resets this account's name and password to these values.
BOOTSTRAP_ADMIN_NAME="ERP Super Admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
